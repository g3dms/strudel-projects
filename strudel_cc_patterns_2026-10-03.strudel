r hats =\n  s(\"hh:2\").struct(\"x x x x*2 x*<1!3 2>x*<1!3 2> x*<1 2> x*2\").pan(.3).gain(.25)  \n    \n\nvar drums =\n  stack(\n  s(\"bd\").struct(\"x - - - <- <x!7 ->> - - - - - - - <x!3 -> - - -\").pan(.5),\n  s(\"sd\").struct(\"- - - - <-!14 x!2> - - - x - <-!31 x> - <-!15 x> - <-!15 x> -\").pan(.4),\n  s(\"sd\").struct(\"- - - - - - - - - - - - <-!3 <x ->> - - -\").pan(.4).velocity(.45),\n  s(\"sd\").struct(\"- - - - - - - - - - - - - - <-!3 <x ->> -\").pan(.4).velocity(.7),\n  s(\"mt\").struct(\"- - - - - - - - - - - - <-!3 <- <x ->>> - - -\").pan(.7),\n  s(\"lt\").struct(\"- - - - - - - - - - - - - - <-!3 <- <x ->>> -\").pan(.8),\n  s(\"cr\").struct(\"<x -!15>\")\n).lpf(4000).gain(.2).fast(2)\n\n$: stack(\n  s(\"pink\").gain(.15),\n  s(\"crackle\").gain(1.5).lpf(4000)\n  ).slow(4)\n\n$:arrange (\n  [4,stack(main,noodle, drums, hats, powerchords, high).fast(2).velocity(0)],\n  [8,main],\n  [8,stack(main,noodle )],\n  [8,stack(main,noodle, powerchords, hats.slow(2),introdrums)],\n  [8,stack(main,noodle, powerchords, drums, hats.slow(2))],\n  [16,stack(main,noodle, powerchords, drums, hats.slow(2))],\n  [16,stack(main,noodle, drums, hats, powerchords, high)],\n  [16,stack(main,noodle, drums, hats, powerchords, high).postgain(\"1 .95 .925 .9 .85 .8 .7 .6 .5 .4 .3 [.2 .1]\".slow(16)).delay(\"0 .2 .5 .8\".slow(16))],\n\n  [4,hats.lpf(3000)],\n \n  [4,silence]\n\n  // [8,drums]\n  \n).color(\"<tomato  salmon pink>\".slow(4))._punchcard()","created_at":1791033948427,"id":"9bOHppOAhv18","collection":"user"},"LLbflEkQUusw":{"code":"$: freq(\"<630 [-@7 830] 780 [690@7 830] 780@3 - 630 [-@7 871] 630 690 [780 780 870] [870 -] 780 690 630 - - - 630 - 780 690 780@7 ->*11\").sound(\"gm_clarinet\")\n._pianoroll()\n$: note(\"<c - [- e@10, - g@6] ->*11\").sound(\"gm_acoustic_guitar_steel\")\n._pianoroll()\n$: freq(\"<-@18 [1175, 2350]*3 [1240, 2490]*4 -@12>*11\").sound(\"gm_accordion\")\n._pianoroll()","created_at":1791033957277,"id":"LLbflEkQUusw","collection":"user"}}