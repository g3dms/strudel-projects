{"cdaYEq7evZgP":{"code":"kick: sound(\"bd hh sd oh\").bank(\"ViscoSpaceDrum\").clip(0.8).struct(\"{x - <-!15 x> -}%16\")\n.duck(2).gain(0.25)\n\nbassline: note(\"[c2 <e2 e2 e2 d2> ~]\").gain(0.25)\n.seg(16).trans(\"[0, 12, 7]\")\n  .sound(\"supersaw\").lpf(4000)\n._punchcard()\n\nbassline2: note(\"c3 e3 g3 [a2 e2]\").trans(\"[-12, -24]\")\n.struct(\"x - - x - - x - - x - - x - <x <- x>> -\")\n.sound(\"[gm_acoustic_bass, gm_synth_bass_2]\")\n.decay(0.25).release(0.25)._punchcard()\narp: note(\"c4 e4 g4 d4\").fast(4)\n.sometimes(trans(\"<12>\"))\n.detune(1).unison(10)\n.o(2).room(1)\n.postgain(0.5)._punchcard()","created_at":1791032423149,"id":"cdaYEq7evZgP","collection":"user"},"jdXoJJyHQSn1":{"code":"// \" nothing left \" @by Vigorous.Elbows\n\n\nsetcpm(33)\n\nvar main =\n  n(\"<[0 2]*4 [0 2]*4 [1 3]*4 <[1 4]*4 [2 4]*4>>\")\n.scale(\"g2:major\")\n  .s(\"gm_synth_bass_2:5\")\n  .room(1)\n  .pan(.3)\n  // .clip(.9)\n  .cutoff(perlin.range(500,8000).slow(2))\n  .att(.01)\n  .gain(slider(0.321,0,1))\n\nvar noodle =\n  n(\"8@3 7@3 6@2 7@3 <6!3 8>@3 <4!3 9>@2\".slow(2))\n.scale(\"G3:major\")\n  .s(\"supersaw\")\n  .room(1)\n  .pan(.7)\n  // .att(.05)\n  .gain(slider(0.171,0,1))\n\nvar powerchords =\n  n(\"< 0, 7 >\".add(\"0 1 2 [3@6 <3 4>@2]\".slow(8)))\n.scale(\"G1:major\")\n  .s(\"supersaw\")\n  .seg(8)\n  .room(1)\n  .pan(.3)\n  .gain(slider(0.354,0,1))\n\n\nvar high =\n  n(\"<[6]!3 11> <[7]!3 11> <[7] <[7] 11>> <[9] <11 10>> <9 <11 10>> <9 <11 10>> <9 <11 9>> <9 <11 9>> <9 <11 8>> <9 <11 8>> <9 <11 8>> <9 <11 9>> <9 <11 9>> <9 <11 9>> <9 <11 8>> <9 <11 8>> \".slow(2))\n.scale(\"G4:major\")\n  .gain(slider(0.12,0,1))\n  .room(1)\n  .pan(.7)\n  .s(\"supersaw\")\n\n\n\nvar introdrums =\n  stack(\n  s(\"bd\").struct(\"<-!14 x x> - - - - - - - - - - - <-!14 x -> - - -\").pan(.5),\n  s(\"sd\").struct(\"- - - - <-!14 x!2> - - - <-!14 x!2> - <-!15 x> - <-!15 x> - <-!15 x> -\").pan(.4),\n).lpf(4000).gain(.2).fast(2)\n  \nvar hats =\n  s(\"hh:2\").struct(\"x x x x*2 x*<1!3 2>x*